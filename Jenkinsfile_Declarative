pipeline {
    agent any

    environment {
        NginxSystemIP = "35.172.179.98"
        NginxserverSSHUserName = "ec2-user"
    }

    stages {
        stage("Remove old files") {
            steps {
                sshagent(['NginxServer_SSH_Credential']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${NginxserverSSHUserName}@${NginxSystemIP} 'sudo rm -rf /usr/share/nginx/html/*'
                    """
                }
            }
        }

        stage("Git Clone") {
            steps {
                git branch: 'main', credentialsId: 'GitHub_Credentials', url: 'https://github.com/onyekaoffodum/static-web-app.git'
            }
        }

        stage("Deploy to Nginx") {
            steps {
                sshagent(['NginxServer_SSH_Credential']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${NginxserverSSHUserName}@${NginxSystemIP} 'sudo chown ec2-user:ec2-user /usr/share/nginx/html/'
                        scp -o StrictHostKeyChecking=no -r * ${NginxserverSSHUserName}@${NginxSystemIP}:/usr/share/nginx/html/
                        ssh -o StrictHostKeyChecking=no ${NginxserverSSHUserName}@${NginxSystemIP} 'sudo systemctl restart nginx'
                    """
                }
            }
        }
    }

    post {
        always {
            script {
                def buildStatus = currentBuild.result ?: 'SUCCESS'
                def slackcolorcode = (buildStatus == 'SUCCESS') ? 'good' : 'danger'
                def color

                if (buildStatus == 'SUCCESS') {
                    color = '#4CAF50' // Green
                } else if (buildStatus == 'FAILURE') {
                    color = '#F44336' // Red
                } else {
                    color = '#FF9800' // Orange
                }

                echo "📣 Sending Slack and Email notifications..."

                // Slack Notification
                slackSend(
                    channel: 'lic-app-team',
                    color: "${slackcolorcode}",
                    message: "🌐 *${env.JOB_NAME}* Build #${env.BUILD_NUMBER} - *${buildStatus}*\nPlease check details: ${env.BUILD_URL}",
                    tokenCredentialId: 'SlackToken'
                )

                // Styled Email Notification
                emailext(
                    subject: "${env.JOB_NAME} - Build #${env.BUILD_NUMBER} - ${buildStatus}",
                    to: 'sandieji@rocketmail.com',
                    mimeType: 'text/html',
                    body: """
                    <html>
                    <head>
                        <style>
                            body {
                                font-family: 'Segoe UI', Arial, sans-serif;
                                background-color: #f4f4f4;
                                margin: 0;
                                padding: 20px;
                            }
                            .container {
                                background: #fff;
                                border-radius: 8px;
                                padding: 20px;
                                box-shadow: 0 2px 6px rgba(0,0,0,0.1);
                            }
                            .header {
                                background-color: ${color};
                                color: white;
                                padding: 15px;
                                border-radius: 8px 8px 0 0;
                                text-align: center;
                                font-size: 20px;
                                font-weight: bold;
                            }
                            .content {
                                padding: 20px;
                                font-size: 14px;
                                color: #333;
                            }
                            .footer {
                                font-size: 12px;
                                color: #888;
                                text-align: center;
                                padding-top: 15px;
                                border-top: 1px solid #ddd;
                            }
                            a.button {
                                display: inline-block;
                                padding: 10px 16px;
                                background-color: ${color};
                                color: white;
                                border-radius: 4px;
                                text-decoration: none;
                                margin-top: 15px;
                            }
                            a.button:hover {
                                background-color: #333;
                            }
                        </style>
                    </head>
                    <body>
                        <div class="container">
                            <div class="header">
                                🌐 ${env.JOB_NAME} – Build #${env.BUILD_NUMBER}
                            </div>
                            <div class="content">
                                <p>Hello,</p>
                                <p>The Jenkins job <b>${env.JOB_NAME}</b> has completed with status:</p>
                                <h2 style="color:${color}; text-align:center;">${buildStatus}</h2>
                                <p>You can view full build details and console output below:</p>
                                <p style="text-align:center;">
                                    <a class="button" href="${env.BUILD_URL}console">View Console Output</a>
                                </p>
                            </div>
                            <div class="footer">
                                Jenkins CI • ${new Date().format("EEE, MMM d yyyy HH:mm:ss z")}
                            </div>
                        </div>
                    </body>
                    </html>
                    """
                )
            }
        }

        success {
            echo "✅ Deployment to Nginx completed successfully!"
        }

        failure {
            echo "❌ Deployment to Nginx failed!"
        }
    }
}
